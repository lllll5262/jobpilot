# 复制为 .env 后按运行环境调整；所有变量统一使用 JOBPILOT_ 前缀。
JOBPILOT_APP_NAME=JobPilot
JOBPILOT_ENVIRONMENT=development
JOBPILOT_DEBUG=false
JOBPILOT_LOG_LEVEL=INFO

# Qwen 配置（默认）
JOBPILOT_LLM_PROVIDER=qwen
JOBPILOT_LLM_API_KEY=
JOBPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBPILOT_LLM_MODEL=qwen-plus
JOBPILOT_LLM_TIMEOUT_SECONDS=60

# 前端模型切换配置。每个模型单独使用自己的 API Key、地址和模型编码。
JOBPILOT_QWEN_API_KEY=
JOBPILOT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBPILOT_QWEN_MODEL=qwen-plus
JOBPILOT_DEEPSEEK_API_KEY=
JOBPILOT_DEEPSEEK_BASE_URL=https://api.deepseek.com
JOBPILOT_DEEPSEEK_MODEL=deepseek-v4-flash
JOBPILOT_GLM_API_KEY=
JOBPILOT_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
JOBPILOT_GLM_MODEL=glm-5.2
JOBPILOT_RESUME_MAX_FILE_SIZE_MB=10
JOBPILOT_RESUME_MAX_PAGES=20
JOBPILOT_RESUME_MAX_TEXT_CHARS=50000

# MySQL 8 + SQLAlchemy Async；不要在版本库中保存真实密码。
JOBPILOT_DATABASE_URL=mysql+aiomysql://jobpilot:change-me@127.0.0.1:3306/jobpilot?charset=utf8mb4
JOBPILOT_DATABASE_ECHO=false

# Redis 仅保存会话、短期 Memory、Cache 和 LangGraph Checkpoint。
JOBPILOT_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
JOBPILOT_SESSION_TTL_SECONDS=86400
JOBPILOT_CONVERSATION_MAX_TURNS=10
JOBPILOT_AGENT_CACHE_TTL_SECONDS=3600
JOBPILOT_CHECKPOINT_TTL_SECONDS=86400

# 完整简历正文与结构化数据保存在 MongoDB；请勿把真实密码提交到 Git。
JOBPILOT_MONGO_URL=mongodb://jobpilot:change-me@127.0.0.1:27017/?authSource=admin
JOBPILOT_MONGO_DATABASE=jobpilot
JOBPILOT_MONGO_RESUME_COLLECTION=resumes

# 父子分块的 BGE-M3 稠密/稀疏向量保存在 Milvus。
JOBPILOT_MILVUS_URI=http://127.0.0.1:19530
JOBPILOT_MILVUS_TOKEN=
JOBPILOT_MILVUS_DATABASE=default
JOBPILOT_MILVUS_RESUME_COLLECTION=jobpilot_resume_chunks
JOBPILOT_RESUME_EMBEDDING_MODEL_PATH=E:/path/to/bge-m3
JOBPILOT_RESUME_EMBEDDING_DEVICE=cpu
JOBPILOT_RESUME_EMBEDDING_USE_FP16=false
JOBPILOT_RESUME_PARENT_CHUNK_SIZE=1000
JOBPILOT_RESUME_CHILD_CHUNK_SIZE=400
JOBPILOT_RESUME_CHUNK_OVERLAP=100
JOBPILOT_RESUME_RETRIEVAL_LIMIT=8
